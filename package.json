{
  "name": "@homebound/graphql-typescript-scalar-type-policies",
  "version": "2.0.0-bump",
  "main": "./build/index.js",
  "types": "./build/",
  "scripts": {
    "build": "rm -rf build; tsc",
    "prepack": "yarn build",
    "test": "./node_modules/.bin/jest --watch",
    "coverage": "./node_modules/.bin/jest --collectCoverage",
    "format": "prettier --write 'src/**/*.{ts,js,tsx,jsx}'",
    "graphql-codegen": "rm integration/graphql-types.ts; graphql-codegen --config integration/graphql-codegen.yml"
  },
  "dependencies": {
    "@graphql-codegen/plugin-helpers": "^6.3.0",
    "change-case": "^4.1.2",
    "ts-poet": "^6.12.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.3.1",
    "graphql": "^16.13.2",
    "husky": "^3.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn format"
    }
  },
  "packageManager": "yarn@4.18.1"
}
